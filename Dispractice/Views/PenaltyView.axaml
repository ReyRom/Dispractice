<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
			 xmlns:vmd="using:Dispractice.ViewModels.Design"
			 xmlns:vm="using:Dispractice.ViewModels"
			 xmlns:m="using:Dispractice.Models"
			 xmlns:v="using:Dispractice.Views"
			 xmlns:e="using:Dispractice.Extensions"
			 xmlns:a="clr-namespace:Material.Styles.Assists;assembly=Material.Styles"
             x:Class="Dispractice.Views.PenaltyView"
			 x:DataType="vm:PenaltyViewModel"
			 Design.Width="500">
	<Design.DataContext>
		<vmd:PenaltyViewModelDesign/>
	</Design.DataContext>
	
	<UserControl.Resources>
		<e:DateFormatConverter x:Key="DateFormatConverter"/>
		<e:PenaltyTypeConverter x:Key="PenaltyTypeConverter"/>
	</UserControl.Resources>
	
	<Grid RowDefinitions="*, Auto" Margin="20">
		<StackPanel Orientation="Vertical" Spacing="10">
			<TextBlock Text="Взыскание" FontSize="18" FontWeight="Bold"/>
			
			<TextBox a:TextFieldAssist.Label="Военнослужащий"
						 UseFloatingWatermark="True"
						 Theme="{StaticResource OutlineTextBox}"
						 Classes="outline densed"
						 Text="{Binding Serviceman}" IsEnabled="False"/>
			
			<ComboBox
				Theme="{StaticResource MaterialOutlineComboBox}"
				a:ComboBoxAssist.Label="Вид взыскания"
				ItemsSource="{Binding PenaltyTypes}"
				SelectedItem="{Binding SelectedPenaltyType}">
				<ComboBox.ItemTemplate>
					<DataTemplate>
						<StackPanel Orientation="Horizontal" Spacing="3">
							<TextBlock Text="{Binding Converter={StaticResource PenaltyTypeConverter}}"/>
						</StackPanel>
					</DataTemplate>
				</ComboBox.ItemTemplate>
			</ComboBox>
			
			<TextBox
				a:TextFieldAssist.Label="За что"
				UseFloatingWatermark="True"
				Theme="{StaticResource OutlineTextBox}"
				Classes="outline densed"
				Text="{Binding Penalty.Description}"
				TextWrapping="Wrap"/>
			<DatePicker
				a:TextFieldAssist.Label="Дата применения"
				SelectedDate="{Binding Penalty.DateApplied, Mode=TwoWay, Converter={StaticResource DateFormatConverter}}"/>

			<DatePicker
				a:TextFieldAssist.Label="Когда совершен проступок"
				SelectedDate="{Binding Penalty.OffenseDate, Mode=TwoWay, Converter={StaticResource DateFormatConverter}}"/>

			<DatePicker
				a:TextFieldAssist.Label="Когда приведено в исполнение"
				SelectedDate="{Binding Penalty.DateExecuted, Mode=TwoWay, Converter={StaticResource DateFormatConverter}}"/>

			<TextBox a:TextFieldAssist.Label="Кем применено"
						 UseFloatingWatermark="True"
						 Theme="{StaticResource OutlineTextBox}"
						 Classes="outline densed"
						 Text="{Binding Penalty.AppliedBy}"/>
			
			<DatePicker
				a:TextFieldAssist.Label="Снято"
				SelectedDate="{Binding Penalty.DateRemoved, Mode=TwoWay, Converter={StaticResource DateFormatConverter}}"/>
				
		</StackPanel>

		<StackPanel Orientation="Horizontal" Spacing="10" Grid.Row="1" HorizontalAlignment="Right" Margin="0,20,0,0">
			<Button Content="Сохранить" Command="{Binding SaveCommand}"/>
			<Button Content="Отмена" Command="{Binding CancelCommand}"/>
		</StackPanel>
	</Grid>
</UserControl>
