<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Dispractice.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:Dispractice.Views"
        mc:Ignorable="d" d:DesignWidth="1024" d:DesignHeight="768"
        x:Class="Dispractice.Views.MainWindow"
        Icon="/Assets/avalonia-logo.ico"
        Title="Dispractice"
        x:DataType="vm:MainViewModel">
	<Grid ColumnDefinitions="Auto, *">
		<Border BorderBrush="{DynamicResource MaterialPrimaryDarkBrush}" BorderThickness="3" IsVisible="{Binding IsNavBarVisible}" MaxWidth="300" >
			<StackPanel Margin="10">
				<Image Source="{Binding Home.Image}" Height="100"/>
				<TextBlock Text="{Binding Home.Title}" FontSize="20" HorizontalAlignment="Center"/>
			
				<ItemsControl ItemsSource="{Binding NavigationList}" Margin="0 10">
					<ItemsControl.ItemTemplate>
						<DataTemplate>
							<Button Margin="0 0 0 10" Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).NavigateCommand}" CommandParameter="{Binding Key}">
								<TextBlock Text="{Binding Value}" TextWrapping="Wrap"/>
							</Button>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>
			</StackPanel>
		</Border>
		<ContentControl Grid.Column="1" Content="{Binding Content}"/>
	</Grid>
</Window>
